# Copy to ".env" for local testing. Never commit ".env" or share API keys.
# In production, set these in Vercel: Project > Settings > Environment Variables.

# Select "gemini" or "openai". Gemini is auto-selected if its key is set.
CHAT_PROVIDER=gemini

# Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI settings (used when CHAT_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional rate limits per visitor IP address.
CHAT_RATE_LIMIT_PER_MINUTE=8
CHAT_RATE_LIMIT_PER_DAY=80

# Optional extra sites allowed to call /api/chat, comma separated.
ALLOWED_ORIGINS=
